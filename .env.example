# Entorno: Development en local, Production en la EC2
ASPNETCORE_ENVIRONMENT=Development

# Base de datos (PostgreSQL)
# En local usa tu PostgreSQL. En AWS usa el endpoint de RDS y agrega ;SSL Mode=Require al final.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ecotrack;Username=ecotrack_app;Password=

# CORS: direcciones del frontend permitidas, separadas por coma
CORS_ORIGINS=http://localhost:5173

# JWT: JWT_SECRET debe tener al menos 32 caracteres
JWT_SECRET=
JWT_ISSUER=EcoTrackAPI
JWT_AUDIENCE=EcoTrackFrontend

# Almacenamiento local (simula el bucket de S3: reportes/ y resultados/)
ALMACENAMIENTO_LOCAL_RUTA=bucket-local

# Auditoría de reportes (opcionales)
AUDITORIA_TOLERANCIA_CO2_KG=0.0001
AUDITORIA_UMBRAL_DISTANCIA_KM=1000
