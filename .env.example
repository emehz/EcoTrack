# Entorno
ASPNETCORE_ENVIRONMENT=Development

# Base de Datos (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=ecotrack;Username=postgres;Password=

# CORS (Frontend)
CORS_ORIGINS=http://localhost:5173

# Almacenamiento local (simula el bucket de S3: reportes/ y resultados/)
ALMACENAMIENTO_LOCAL_RUTA=bucket-local

# JWT (Para futura autenticación)
JWT_SECRET=cambiar_por_clave_segura
JWT_ISSUER=EcoTrackAPI
JWT_AUDIENCE=EcoTrackFrontend

# Configuración del Servidor Backend en AWS
PORT=3000
NODE_ENV=production

# Configuración de Amazon RDS (PostgreSQL)
DB_HOST=<Endpoint_de_RDS>
DB_PORT=5432
DB_NAME=ecotrack_db
DB_USER=ecotrack_app
DB_PASSWORD=<Tu_Contraseña_Segura>
DB_SSL=true
DB_SSL_CA=/opt/ecotrack/certs/global-bundle.pem
DB_POOL_MAX=5

# Configuración de AWS (Para el SDK de S3 si lo usas)
AWS_REGION=us-east-2
S3_BUCKET_NAME=<Nombre_De_Tu_Bucket>
